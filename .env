# --- HTTP server ---
PORT=8080
WEBHOOK_PATH=/webhook/appointment/booking/payment
MAX_BODY_BYTES=1048576

# --- RabbitMQ: either a full URL ...
# RABBITMQ_URL=amqps://user:pass@host:5671/vhost
# --- ... or the individual parts (used when RABBITMQ_URL is empty) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqps://ancyogen:hmfyxAXqds2aFNChyOlsrSicR_0UpQSM@warthog.lmq.cloudamqp.com/ancyogen
RABBITMQ_TLS=false
RAZORPAY_WEBHOOK_SECRET=">uvZw6H89#1B^21)S"

# --- Topology (declared automatically, durable) ---
RABBITMQ_EXCHANGE=alshifa.payments
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_ROUTING_KEY=payment.webhook
RABBITMQ_QUEUE=alshifa.payment.webhooks

